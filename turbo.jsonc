{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "futureFlags": {
    // Task `command` is experimental; it lets every package share one
    // definition of a leaf command instead of a copied script.
    "experimentalTaskCommand": true,
    // `--affected` selects only the tasks whose `inputs` match the diff,
    // not every task in a changed package.
    "affectedUsingTaskInputs": true,
    // actions/checkout leaves the PR base only as `origin/<base>`; without
    // this `--affected` cannot resolve it and runs every task.
    "githubActionsRemoteBaseRefFallback": true
  },
  // Bounds the local cache, which CI also restores between runs.
  "cacheMaxSize": "2GB",
  // Declared vars are read at run time (ports, deploy stages, secrets), not
  // baked into outputs, so they reach tasks without keying the cache. Vite's
  // build-time VITE_* vars are hashed by turbo's framework inference. NIX_*
  // passes through by default.
  "globalPassThroughEnv": [
    "TMPDIR",
    "PORT",
    "ALCHEMY_STAGE",
    "ALCHEMY_PROFILE"
  ],
  "globalEnv": ["APP_ENV"],
  "globalDependencies": ["patches/**"],
  // Task-inheritance pattern:
  //   "^task"        -> run `task` in all DEPENDENCY packages first
  //   "task"         -> run `task` in the SAME package first
  //   "//#task"      -> a root-only task (defined in root package.json)
  //   "pkg#task"     -> `task` in one named package
  // Leaf commands every package shares are task `command`s (argv, no shell),
  // defined here once instead of copied into each package.json. A package script
  // of the same name overrides one; `"command": null` in a package's turbo.jsonc
  // opts the package out. Other leaf commands are package scripts. Aggregates
  // (`lint`, `lint:check`) have neither: they only fan out through `dependsOn`,
  // so turbo is never called from a script.
  // A package turbo.jsonc inherits each root task: scalar fields carry over, and
  // an array field it sets replaces the root's array.
  // @see https://turborepo.dev/docs/reference/package-configurations#inheritance-behavior
  // The root depends on no internal package: turbo hashes the source of every
  // internal package the root depends on into the global hash, so one such
  // dependency misses cache for every task in the repo.
  // @see https://turborepo.dev/docs/crafting-your-repository/caching#root-workspace-dependencies
  "tasks": {
    // Tests, typecheck and type-aware lint read workspace sources, not build
    // output, so they depend on this no-op instead of `^build`: dependency
    // hashes still flow in, nothing gets built.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "outputLogs": "new-only"
    },
    // Internal packages export source, so a dev server builds nothing first.
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "command": ["bun", "run", "tsc", "--noEmit"],
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputLogs": "new-only"
    },
    "test": {
      "command": ["bun", "run", "vitest", "run"],
      "dependsOn": ["^transit"],
      "outputLogs": "new-only"
    },
    "clean": {
      "command": ["bun", "run", "rm", "-rf", "dist", ".turbo"],
      "cache": false
    },
    // oxlint runs per package so an edit re-lints only the packages whose
    // sources or type dependencies changed. Type-aware rules read dependency
    // types, so the `^transit` edge carries their hashes.
    "oxlint:check": {
      "command": ["bun", "run", "oxlint", "-c", "../../oxlint.config.ts", "."],
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/oxlint.config.ts"
      ],
      "outputLogs": "new-only"
    },
    // Fixers are never cached: a hit on the pre-fix hash would replay the old
    // run and leave the files unfixed.
    "oxlint:fix": {
      "command": [
        "bun",
        "run",
        "oxlint",
        "-c",
        "../../oxlint.config.ts",
        "--fix",
        "."
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/oxlint.config.ts"
      ],
      "cache": false
    },
    "lint:check": {
      "dependsOn": ["oxlint:check", "typecheck", "//#lint:check:root"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["oxlint:fix", "typecheck", "//#lint:root"],
      "outputLogs": "new-only"
    },
    // === Root-only tasks (bodies live in root package.json scripts) ===
    // Repo-wide checkers. Packages reach them through `lint:check`; CI runs
    // `//#lint:check:root` directly so they run even when no package changed.
    "//#lint:check:root": {
      "dependsOn": [
        "//#typecheck",
        "//#oxlint:check",
        "//#oxfmt:check",
        "//#jscpd:check",
        "//#knip:check",
        "//#catalog:check",
        "//#effect-versions:check",
        "//#nix:fmt:check"
      ]
    },
    "//#lint:root": {
      "dependsOn": [
        "//#typecheck",
        "//#oxlint:fix",
        "//#oxfmt:fix",
        "//#jscpd:check",
        "//#knip:fix:danger",
        "//#catalog:fix",
        "//#effect-versions:check",
        "//#nix:fmt:fix"
      ]
    },
    // The root package checks only root-level files (configs); every package
    // checks itself.
    "//#typecheck": {
      "inputs": ["*.ts", "tsconfig.json"]
    },
    "//#oxlint:check": {
      "inputs": ["*.ts", "tsconfig.json"]
    },
    "//#oxlint:fix": {
      "inputs": ["*.ts", "tsconfig.json"],
      "cache": false
    },
    "//#oxfmt:check": {},
    // Fixers that write the same files run one after another: oxlint and
    // catalog fixes first, then oxfmt formats what they wrote, then knip. knip
    // goes last so no other fix pulls it in.
    "//#oxfmt:fix": {
      "dependsOn": [
        "//#oxlint:fix",
        "//#catalog:fix",
        "@worldmap-paintball/web#oxlint:fix",
        "@worldmap-paintball/api#oxlint:fix"
      ],
      "cache": false
    },
    "//#jscpd:check": {},
    // `knip:fix:danger` deletes what knip believes is dead; a missing entry in
    // knip.ts makes it delete live code, so review its diff like a codemod.
    "//#knip:check": {},
    "//#knip:fix:danger": {
      "dependsOn": ["//#oxfmt:fix"],
      "cache": false
    },
    "//#catalog:check": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json"
      ]
    },
    "//#catalog:fix": {
      "cache": false
    },
    "//#effect-versions:check": {
      "inputs": ["bun.lock"]
    },
    "//#nix:fmt:check": {
      "inputs": ["flake.nix", "flake.lock"]
    },
    "//#nix:fmt:fix": {
      "cache": false
    }
  }
}
