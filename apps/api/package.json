    "varlock": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "shoemaker-typescript-config": "catalog:",
    "tsdown": "catalog:",
