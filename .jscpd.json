{
  "pattern": "**/*",
  "ignore": [
    "**/package.json",
    "**/bun.lock",
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/.nx/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/.vite/**",
    "**/.tanstack/**",
    "**/.expo/**",
    "**/.alchemy/**",
    "**/.direnv/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/android/**",
    "**/ios/**",
    "**/*.svg",
    "**/*.gen.*",
    "**/generated/**",
    "**/vendor/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.github/**",
    "**/.changeset/**",
    "**/docs/cloned-repos-as-docs/**",
    "**/README.md",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/apps/web/src/routeTree.gen.ts"
  ],
  "threshold": 0,
  "minTokens": 50,
  "minLines": 33,
  "maxLines": 1000,
  "maxSize": "100kb"
}
