# shoemaker:begin header
# Environment schema (env-spec) for worldmap-paintball. Declares every variable the
# repo reads; values live in .env.local (gitignored) or a varlock plugin, never
# here. App code reads them through `ENV` from varlock/env, never process.env.
# Docs: https://varlock.dev/env-spec/overview/
#
# @defaultSensitive=false @defaultRequired=infer @currentEnv=$APP_ENV
# ---
# shoemaker:end header

# shoemaker:begin vars

# Deployment stage this process runs as; selects per-stage env files and profiles
# @optional @type=enum(development, staging, production)
APP_ENV=development

# Alchemy profile whose credentials deploy (`alchemy profile edit`)
# @optional @tag(infra)
ALCHEMY_PROFILE=

# Alchemy stage (defaults to live_$USER for deploy, dev_$USER for dev)
# @optional @tag(infra)
ALCHEMY_STAGE=

# Port the HTTP API listens on
# @optional @type=port @tag(api)
PORT=3000

# shoemaker:end vars

# Project-only variables go below; shoemaker never touches them.

# Directory of building footprint packs from `bun run footprints:build`, read by the
# Bun dev server and uploaded on deploy (default: <repo>/tmp/footprints)
# @optional @tag(api)
FOOTPRINTS_DIR=
